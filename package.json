{
  "name": "bugent",
  "version": "0.0.0",
  "module": "src/index.ts",
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@typescript/native-preview": "7.0.0-dev.20260707.2"
  },
  "bin": {
    "bugent": "./src/index.ts"
  },
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsgo --noEmit",
    "butui": "cd src/butui && bun --conditions=browser run main.tsx",
    "butui:typecheck": "cd ../buTUI && bun --conditions=browser x tsc --noEmit -p ../bugent/src/butui/tsconfig.typecheck.json",
    "build:sandbox": "bun run scripts/build-sandbox.ts",
    "runtime:install": "bun run scripts/install-bun-runtime.ts",
    "package:bun-runtime": "bun run runtime/bun/scripts/package.ts"
  },
  "type": "module",
  "dependencies": {
    "highlight.js": "^11.12.0"
  }
}
